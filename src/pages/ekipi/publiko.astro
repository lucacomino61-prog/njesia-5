---
import TeamShell from '../../components/TeamShell.astro';
import { href, t as tr } from '../../i18n';
import { isTeam } from '../../lib/auth';
import { listPlaces } from '../../lib/queries';
import { toTiranaWall } from '../../lib/time';

const { lang, user, path } = Astro.locals;
const t = tr(lang);
const sq = lang === 'sq';
if (!user) return Astro.redirect(href(lang, '/hyr') + `?pas=${encodeURIComponent(href(lang, path))}`, 303);
if (!isTeam(user)) return Astro.redirect(href(lang, '/'), 303);
const places = await listPlaces();
const back = href(lang, '/ekipi/publiko');
const today = toTiranaWall(Date.now()).slice(0, 10);
const cats = ['decision', 'news', 'activity', 'success_story', 'new_business', 'neighbor'];
---
<TeamShell title={sq ? 'Publiko' : 'Publish'} tab="publish">
  <div class="grid2">
    <section class="panel" id="lajm">
      <h2 class="h3">{sq ? 'Lajm ose vendim' : 'News or decision'}</h2>
      <form method="post" action="/do/news" data-enhance>
        <input type="hidden" name="back" value={back} /><input type="hidden" name="lang" value={lang} />
        <div class="field"><label for="n-cat">{sq ? 'Kategoria' : 'Category'}</label>
          <select class="select" id="n-cat" name="category">{cats.map((c) => <option value={c}>{t.decisions.categories[c]}</option>)}</select></div>
        <div class="field"><label for="n-title">{t.compose.title}</label><input class="input" id="n-title" name="title" required minlength="5" maxlength="160" /></div>
        <div class="field"><label for="n-body">{t.compose.body}</label><textarea class="textarea" id="n-body" name="body" required minlength="10" rows="6"></textarea></div>
        <label class="check"><input type="checkbox" name="pinned" value="1" /> {sq ? 'Fiksoje në krye' : 'Pin to top'}</label>
        <p class="form-error" role="alert"></p>
        <button class="btn" type="submit">{t.compose.publish}</button>
      </form>
    </section>

    <section class="panel" id="ngjarje">
      <h2 class="h3">{sq ? 'Ngjarje' : 'Event'}</h2>
      <form method="post" action="/do/event" data-enhance>
        <input type="hidden" name="back" value={back} /><input type="hidden" name="lang" value={lang} />
        <div class="field"><label for="e-title">{t.compose.title}</label><input class="input" id="e-title" name="title" required minlength="5" maxlength="140" /></div>
        <div class="field"><label for="e-desc">{sq ? 'Përshkrimi' : 'Description'}</label><textarea class="textarea" id="e-desc" name="description" rows="4"></textarea></div>
        <div class="field"><label for="e-date">{sq ? 'Data' : 'Date'}</label><input class="input" id="e-date" name="date" type="date" required min={today} /></div>
        <div class="grid2">
          <div class="field"><label for="e-start">{sq ? 'Fillon' : 'Starts'}</label><input class="input" id="e-start" name="start" type="time" required value="18:00" /></div>
          <div class="field"><label for="e-end">{sq ? 'Mbaron' : 'Ends'}</label><input class="input" id="e-end" name="end" type="time" required value="19:30" /></div>
        </div>
        <p class="hint meta">{sq ? 'Ora që shkruan është ora e Tiranës.' : 'The time you enter is Tirana time.'}</p>
        <div class="field"><label for="e-kind">{sq ? 'Lloji' : 'Type'}</label>
          <select class="select" id="e-kind" name="kind"><option value="in_person">{t.events.inPerson}</option><option value="online">{t.events.online}</option></select></div>
        <div class="field"><label for="e-place">{sq ? 'Vendi' : 'Place'}</label><input class="input" id="e-place" name="place_text" maxlength="140" placeholder={sq ? 'P.sh. Oborri i shkollës' : 'E.g. School yard'} /></div>
        <div class="field"><label for="e-tag">{t.compose.place}</label>
          <select class="select" id="e-tag" name="place"><option value="">{t.forum.wholeUnit}</option>{places.map((p) => <option value={p.slug}>{p.name}</option>)}</select></div>
        <div class="field"><label for="e-url">{sq ? 'Lidhja e takimit online (opsionale)' : 'Online meeting link (optional)'}</label><input class="input" id="e-url" name="online_url" type="url" placeholder="https://" /></div>
        <p class="form-error" role="alert"></p>
        <button class="btn" type="submit">{sq ? 'Publiko ngjarjen' : 'Publish event'}</button>
      </form>
    </section>

    <section class="panel" id="sondazh">
      <h2 class="h3">{sq ? 'Sondazh' : 'Poll'}</h2>
      <form method="post" action="/do/poll" data-enhance>
        <input type="hidden" name="back" value={back} /><input type="hidden" name="lang" value={lang} />
        <div class="field"><label for="p-q">{sq ? 'Pyetja' : 'Question'}</label><input class="input" id="p-q" name="question" required minlength="5" maxlength="200" /></div>
        {[1, 2, 3, 4, 5].map((n) => (
          <div class="field"><label for={`p-o${n}`}>{sq ? `Përgjigja ${n}` : `Answer ${n}`}{n > 2 ? (sq ? ' (opsionale)' : ' (optional)') : ''}</label><input class="input" id={`p-o${n}`} name="option" maxlength="120" required={n <= 2} /></div>
        ))}
        <div class="field"><label for="p-days">{sq ? 'Mbyllet pas (ditë)' : 'Closes after (days)'}</label><input class="input" id="p-days" name="days" type="number" min="1" max="60" value="7" /></div>
        <p class="form-error" role="alert"></p>
        <button class="btn" type="submit">{sq ? 'Publiko sondazhin' : 'Publish poll'}</button>
      </form>
    </section>

    <section class="panel" id="live">
      <h2 class="h3">{sq ? 'Takim live' : 'Town hall'}</h2>
      <form method="post" action="/do/townhall" data-enhance>
        <input type="hidden" name="op" value="create" />
        <input type="hidden" name="back" value={back} /><input type="hidden" name="lang" value={lang} />
        <div class="field"><label for="t-title">{t.compose.title}</label><input class="input" id="t-title" name="title" required minlength="5" maxlength="140" /></div>
        <div class="field"><label for="t-desc">{sq ? 'Për çfarë flitet' : 'What it is about'}</label><textarea class="textarea" id="t-desc" name="description" rows="3"></textarea></div>
        <div class="field"><label for="t-when">{sq ? 'Data dhe ora (Tiranë)' : 'Date and time (Tirana)'}</label><input class="input" id="t-when" name="when" type="datetime-local" required min={`${today}T00:00`} /></div>
        <p class="form-error" role="alert"></p>
        <button class="btn" type="submit">{sq ? 'Cakto takimin' : 'Schedule'}</button>
      </form>
    </section>
  </div>
</TeamShell>
<style>
  .check { display: flex; align-items: center; gap: var(--space-3); min-height: 44px; font-weight: 600; }
  .check input { width: 1.25rem; height: 1.25rem; accent-color: var(--ink); }
</style>
