---
import Layout from '../layouts/Layout.astro';
import FeedRow from '../components/FeedRow.astro';
import PollBlock from '../components/PollBlock.astro';
import Icon from '../components/Icon.astro';
import { t as tr, href } from '../i18n';
import { feedPosts, listPolls, listPlaces, proposalGoal, type FeedType } from '../lib/queries';

const { lang, user } = Astro.locals;
const t = tr(lang);
const TYPES: Record<string, FeedType> = { tema: 'topics', propozime: 'proposals', realizuara: 'delivered', sondazhe: 'polls' };
const typeParam = Astro.url.searchParams.get('lloji') ?? '';
const type: FeedType = TYPES[typeParam] ?? 'all';
const places = await listPlaces();
const placeParam = Astro.url.searchParams.get('vendi');
const place = places.find((p) => p.slug === placeParam) ?? null;
const before = Number(Astro.url.searchParams.get('para')) || null;
const LIMIT = 20;

const [posts, polls, goal] = await Promise.all([
  type === 'polls' ? Promise.resolve([]) : feedPosts({ type, place: place?.slug, viewer: user?.id, limit: LIMIT, before }),
  type === 'all' || type === 'polls' ? (before ? Promise.resolve([]) : listPolls({ viewer: user?.id, limit: type === 'polls' ? 20 : 2, place: place?.slug, open: type === 'all' })) : Promise.resolve([]),
  proposalGoal(),
]);

const qs = (o: Record<string, string | null | undefined>) => {
  const p = new URLSearchParams();
  for (const [k, v] of Object.entries(o)) if (v) p.set(k, v);
  const s = p.toString();
  return '/forumi' + (s ? '?' + s : '');
};
const tabs: [string, string][] = [
  ['', t.forum.all],
  ['tema', t.forum.topics],
  ['propozime', t.forum.proposals],
  ['realizuara', t.forum.delivered],
  ['sondazhe', t.forum.polls],
];
const nextCursor = posts.length === LIMIT ? posts[posts.length - 1].activity_at : null;
const title = place ? `${t.forum.title}: ${place.name}` : t.forum.title;
const empty = posts.length === 0 && polls.length === 0;
---
<Layout title={title} description={t.forum.lead}>
  <div class="wrap page">
    <header class="page__head">
      <h1 class="poster">{t.forum.title}</h1>
      <p class="lead">{t.forum.lead}</p>
    </header>

    <div class="compose">
      <a class="compose__prompt" href={href(lang, '/shkruaj')}><Icon name="pencil" />{t.forum.composerPrompt}</a>
      <a class="btn" href={href(lang, '/shkruaj')}>{t.forum.write}</a>
      <a class="btn btn--line" href={href(lang, '/propozo')}><Icon name="lightbulb" />{t.forum.propose}</a>
    </div>

    <nav class="filters" aria-label={t.forum.typeLabel}>
      <div class="chips">
        {tabs.map(([k, label]) => (
          <a class="chip" href={href(lang, qs({ lloji: k, vendi: place?.slug }))} aria-current={typeParam === k || (!TYPES[typeParam] && !k) ? 'page' : undefined}>{label}</a>
        ))}
      </div>
    </nav>
    <nav class="filters" aria-label={t.forum.placeLabel}>
      <div class="chips">
        <a class="chip" href={href(lang, qs({ lloji: typeParam }))} aria-current={!place ? 'page' : undefined}>{t.forum.wholeUnit}</a>
        {places.map((p) => (
          <a class="chip" href={href(lang, qs({ lloji: typeParam, vendi: p.slug }))} aria-current={place?.slug === p.slug ? 'page' : undefined}>
            <Icon name="mapPin" />{p.name}
          </a>
        ))}
      </div>
    </nav>

    {polls.length > 0 && (
      <div class="polls">
        <h2 class="sr-only">{t.forum.polls}</h2>
        {polls.map((p) => <PollBlock poll={p} />)}
      </div>
    )}

    {empty ? (
      <div class="empty">
        <p class="h3">{place ? t.forum.emptyPlace(place.name) : t.forum.empty}</p>
        <a class="btn" href={href(lang, '/shkruaj')}>{t.forum.write}</a>
      </div>
    ) : (
      <h2 class="sr-only">{type === 'all' ? t.forum.title : tabs.find(([k]) => k === typeParam)?.[1] ?? t.forum.title}</h2>
      <div class="rows feed" data-reveal>
        {posts.map((p) => <FeedRow post={p} goal={goal} />)}
      </div>
    )}

    {nextCursor && (
      <a class="btn btn--line more" href={href(lang, qs({ lloji: typeParam, vendi: place?.slug, para: String(nextCursor) }))}>{t.forum.more}</a>
    )}
  </div>
</Layout>

<style>
  .page {
    padding-top: var(--space-7);
  }
  .page__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .compose {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 2.5px solid var(--ink);
    margin-bottom: var(--space-6);
  }
  .compose__prompt {
    flex: 1 1 16rem;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    color: var(--ink-2);
    font-weight: 600;
    text-decoration: none;
  }
  .filters {
    margin-bottom: var(--space-3);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filters .chips {
    flex-wrap: nowrap;
    padding-bottom: 2px;
  }
  @media (min-width: 900px) {
    .filters .chips {
      flex-wrap: wrap;
    }
  }
  .polls {
    display: grid;
    gap: var(--space-7);
    margin-block: var(--space-6);
    max-width: 52rem;
  }
  .feed {
    max-width: 62rem;
    margin-top: var(--space-4);
  }
  .empty {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-block: var(--space-8);
  }
  .more {
    margin-top: var(--space-6);
  }
</style>
