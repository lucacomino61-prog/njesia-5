---
import AuthShell from '../components/AuthShell.astro';
import Icon from '../components/Icon.astro';
import { t as tr, href } from '../i18n';
import { callAuth, readForm } from '../lib/authflow';
import { env } from 'cloudflare:workers';

const { lang } = Astro.locals;
const t = tr(lang);
let sent = false;
if (Astro.request.method === 'POST') {
  const f = await readForm(Astro);
  const email = String(f.get('email') ?? '').trim().slice(0, 200);
  // the answer is the same whether or not the account exists
  await callAuth((a) =>
    a.api.requestPasswordReset({ body: { email, redirectTo: env.SITE_URL + href(lang, '/fjalekalim-i-ri') }, headers: Astro.request.headers, asResponse: true }),
  );
  sent = true;
}
---
<AuthShell title={t.auth.forgotTitle} lead={sent ? undefined : t.auth.forgotLead}>
  {sent ? (
    <p class="notice notice--ok" role="status">{t.auth.forgotSent}</p>
  ) : (
    <form method="post" action={href(lang, '/harrova')}>
      <div class="field">
        <label for="email">{t.auth.email}</label>
        <input class="input" id="email" name="email" type="email" autocomplete="email" inputmode="email" required />
      </div>
      <button class="btn" type="submit">{t.auth.forgotSend}<Icon name="arrowRight" /></button>
    </form>
  )}
  <a class="signlink" href={href(lang, '/hyr')}><Icon name="arrowLeft" />{t.auth.back}</a>
</AuthShell>
